# Copia este fichero como .env (en esta misma carpeta, Redis/) y rellénalo con los datos
# de tu base de datos: en Redis Cloud, Databases > tu base de datos > Connect.
# El .env está en el .gitignore: nunca se sube a GitHub.
REDIS_CLOUD_HOST=XXXXX.db.redis.io
REDIS_CLOUD_PORT=XXXXX
REDIS_CLOUD_PASSWORD=

# ACL: contraseña de cada usuario creado en Data Access Control > Users
# (los nombres de usuario deben ser exactamente backend, app, bibliotecario y analista)
REDIS_CLOUD_PASSWORD_BACKEND=
REDIS_CLOUD_PASSWORD_APP=
REDIS_CLOUD_PASSWORD_BIBLIOTECARIO=
REDIS_CLOUD_PASSWORD_ANALISTA=
